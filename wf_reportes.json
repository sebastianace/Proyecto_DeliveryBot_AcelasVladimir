    {
      "parameters": {
        "jsCode": "\n// === GENERAR REPORTE DIARIO ===\n// Filtra pedidos de HOY, calcula metricas y construye el mensaje.\n// Optimizacion: hace todo en memoria con un solo recorrido O(n).\n\nconst hoy = new Date().toLocaleDateString('en-CA', {timeZone:'America/Bogota'}); // YYYY-MM-DD\nconst filas = $input.all().map(i => i.json).filter(r => r.id_pedido);\n\n// filtrar solo los de hoy y excluir Cancelados para el ingreso\nconst hoyRows = filas.filter(r => String(r.fecha || '').trim() === hoy);\nconst activos = hoyRows.filter(r => r.estado !== 'Cancelado');\n\nconst total_pedidos = hoyRows.length;\nconst cancelados    = hoyRows.filter(r => r.estado === 'Cancelado').length;\nconst ingresos      = activos.reduce((s, r) => s + Number(r.total_pago || 0), 0);\nconst ticket_prom   = activos.length ? ingresos / activos.length : 0;\n\n// estados\nconst estados = {};\nfor (const r of hoyRows) estados[r.estado] = (estados[r.estado]||0)+1;\nconst estadoStr = Object.entries(estados).map(([k,v])=>`${k}: ${v}`).join(' | ');\n\n// top productos (parsear detalles_pedido JSON)\nconst conteo = {};\nfor (const r of activos) {\n  let items = [];\n  try { items = JSON.parse(r.detalles_pedido || '[]'); } catch(e) {}\n  for (const it of items) {\n    conteo[it.nombre] = (conteo[it.nombre]||0) + Number(it.cantidad||0);\n  }\n}\nconst top3 = Object.entries(conteo).sort((a,b)=>b[1]-a[1]).slice(0,3)\n  .map(([n,c],i)=>`${['🥇','🥈','🥉'][i]} ${n} (${c} uds)`).join('\\n');\n\nconst ts = new Date().toLocaleString('es-CO',{timeZone:'America/Bogota'});\n\nconst mensaje = `📊 <b>REPORTE DIARIO — DeliveryBot</b>\\n📅 ${hoy}  🕐 ${ts}\\n\\n` +\n  `📦 Pedidos hoy: <b>${total_pedidos}</b> (${cancelados} cancelados)\\n` +\n  `💵 Ingresos: <b>$${ingresos.toFixed(2)}</b>\\n` +\n  `🎯 Ticket promedio: $${ticket_prom.toFixed(2)}\\n` +\n  `📋 Estados: ${estadoStr || 'Sin pedidos'}\\n\\n` +\n  `🏆 <b>Top productos</b>\\n${top3 || '—'}`;\n\nreturn [{json:{\n  fecha: hoy, total_pedidos, cancelados, ingresos: ingresos.toFixed(2),\n  ticket_promedio: ticket_prom.toFixed(2), top_productos: top3.replace(/<[^>]+>/g,''),\n  estados: estadoStr, mensaje, generado_en: ts\n}}];\n"
      },
